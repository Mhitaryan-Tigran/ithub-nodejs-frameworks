PORT=3000
DATABASE_URL=postgresql://blog:blog@localhost:5432/blog
PAGE_SIZE=10
MAX_PAGE_SIZE=50
NODE_ENV=development
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOGIN_RATE_LIMIT=10
BCRYPT_ROUNDS=10
CHAT_MESSAGE_MAX=1000
CHAT_HISTORY_LIMIT=50
REDIS_URL=redis://localhost:6379
RUN_WORKER=false
REMINDER_DELAY_MS=86400000
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-board-password
