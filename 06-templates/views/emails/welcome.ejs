<!doctype html>
<html lang="ru">
<head><meta charset="utf-8"><title>Добро пожаловать, <%= user.name %></title></head>
<body style="margin:0;padding:24px;background:#f5f5f7;font-family:-apple-system,Helvetica,Arial,sans-serif;color:#1d1d1f">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px">
    <tr><td style="padding:32px">
      <p style="margin:0 0 8px;font-size:13px;color:#6e6e73"><%= siteName %></p>
      <h1 style="margin:0 0 16px;font-size:24px">Добро пожаловать, <%= user.name.split(' ')[0] %>!</h1>
      <p style="margin:0 0 16px;line-height:1.5">Ваш аккаунт создан с ролью <strong><%= user.role %></strong>. Профиль уже доступен коллегам.</p>
      <p style="margin:0 0 24px"><a href="<%= loginUrl %>" style="display:inline-block;padding:12px 20px;border-radius:980px;background:#0071e3;color:#ffffff;text-decoration:none">Открыть профиль</a></p>
      <p style="margin:0;font-size:13px;color:#6e6e73">Письмо отправлено на <%= user.email %>.</p>
    </td></tr>
  </table>
</body>
</html>
